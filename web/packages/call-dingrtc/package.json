{
  "name": "@imkit/call-dingrtc",
  "version": "0.1.0",
  "description": "An RTC adapter for @imkit/call over Alibaba Cloud's DingRTC Web SDK (ARTC 3.0); the app installs dingrtc and passes it in",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@imkit/call": "0.1.0"
  },
  "peerDependencies": {
    "dingrtc": "^3.9.37"
  },
  "peerDependenciesMeta": {
    "dingrtc": {
      "optional": true
    }
  }
}
