{
  "name": "@talkwire/group-join",
  "version": "0.1.0",
  "description": "Scan-to-join for Talkwire on the web: group QR tokens, joining, and reviewing join requests (protocol section 14), with optional React components",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "dependencies": {
    "@talkwire/client": "0.1.0"
  },
  "peerDependencies": {
    "@talkwire/react": "0.1.0",
    "react": ">=18.2 <20"
  },
  "peerDependenciesMeta": {
    "@talkwire/react": { "optional": true },
    "react": { "optional": true }
  }
}
