// ImKit host models. Copy this file into your Prisma schema folder (or its
// models into your schema.prisma) and migrate as usual; the Prisma stores in
// @imkit/host-node/prisma read and write these models. Every field maps to an
// explicit column name, so the tables look the same whatever naming your own
// models use. Hosts without Prisma can create the same tables from
// prisma/imkit.sql.
//
// Host user ids are the host's own ids, opaque to ImKit (at most 128
// characters). Nothing here references the host's user table, so the models
// work beside any user model; add relations in your copy if you want them.

/// A user's chat profile.
model ImkitProfile {
  userId          String    @id @map("user_id") @db.VarChar(128)
  /// The user's wire uid: "uid_" + base64url(SHA-256(userId)[:8]).
  uid             String    @unique @map("uid") @db.VarChar(15)
  /// The handle as the user chose it.
  handle          String    @map("handle") @db.VarChar(64)
  /// The handle in lower case: handles are unique regardless of case.
  handleKey       String    @unique @map("handle_key") @db.VarChar(64)
  handleChangedAt DateTime? @map("handle_changed_at") @db.Timestamptz(3)
  displayName     String    @map("display_name") @db.VarChar(64)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(512)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("imkit_profiles")
}

/// The relationship between two users; at most one per pair.
model ImkitContact {
  id             String   @id @default(uuid()) @map("id") @db.Uuid
  /// The two user ids, sorted, as a JSON array: the same for both directions.
  pairKey        String   @unique @map("pair_key")
  /// The user who asked.
  requesterId    String   @map("requester_id") @db.VarChar(128)
  recipientId    String   @map("recipient_id") @db.VarChar(128)
  /// pending, accepted, rejected or blocked.
  status         String   @map("status") @db.VarChar(16)
  /// The requester's private remark for the recipient.
  requesterAlias String?  @map("requester_alias") @db.VarChar(64)
  /// The recipient's private remark for the requester.
  recipientAlias String?  @map("recipient_alias") @db.VarChar(64)
  /// Who blocked, while status is blocked.
  blockedBy      String?  @map("blocked_by") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([requesterId, status, updatedAt], map: "imkit_contacts_requester_idx")
  @@index([recipientId, status, updatedAt], map: "imkit_contacts_recipient_idx")
  @@map("imkit_contacts")
}

/// An administrator action on chat records. Metadata only: never message content.
model ImkitAdminAudit {
  id             String    @id @default(uuid()) @map("id") @db.Uuid
  adminId        String    @map("admin_id") @db.VarChar(128)
  action         String    @map("action") @db.VarChar(64)
  targetUserId   String?   @map("target_user_id") @db.VarChar(128)
  topic          String?   @map("topic") @db.VarChar(128)
  reason         String?   @map("reason") @db.VarChar(500)
  /// pending, success or failed.
  status         String    @map("status") @db.VarChar(16)
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(128)
  details        Json?     @map("details")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([createdAt], map: "imkit_admin_audit_created_idx")
  @@map("imkit_admin_audit")
}
