# The website: talkwire.openedskill.com, served from the release that the
# deploy workflow (.github/workflows/site.yml) last switched "current" to.
# Install as /etc/caddy/Caddyfile, or import it from there; then
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

(talkwire_site) {
	root * /var/www/talkwire/current
	encode zstd gzip

	# VitePress builds with cleanUrls: /guide/quickstart is guide/quickstart.html.
	try_files {path} {path}.html {path}/index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Hashed file names never change content: cache them for a year. Every
	# other file (the HTML pages, hashmap.json) is revalidated on each visit,
	# so a deploy shows at once. The two matchers never match the same request.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}
}

# The domain is proxied by Cloudflare, which already sends visitors to HTTPS.
# Both schemes serve the site and the origin never redirects: Cloudflare's
# Flexible mode reaches the origin over HTTP, and a redirect there would loop.
# Defining the http:// site also turns off Caddy's own redirect for the host.
# Caddy still gets a certificate for the https:// site: Cloudflare passes
# /.well-known/acme-challenge/ over plain HTTP, so the HTTP-01 challenge
# reaches port 80. With that certificate, Cloudflare's "Full (strict)" works.
http://talkwire.openedskill.com {
	import talkwire_site
}

https://talkwire.openedskill.com {
	import talkwire_site
}

# Other sites on this server, each in its own file: the sandbox
# (deploy/imtalk/imtalk.caddy) is installed as /etc/caddy/sites/imtalk.caddy.
import /etc/caddy/sites/*.caddy
