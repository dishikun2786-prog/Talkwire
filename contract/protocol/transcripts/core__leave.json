      "sent": {
        "action": "get",
        "topic": "${grp}",
        "afterSeq": 1,
        "limit": 10
      },
      "frames": {
        "b": [
          {
            "action": "get",
            "code": 200,
            "id": "s15",
            "messages": [
              {
                "content": "after",
                "contentType": "text/plain",
                "from": "${uid:A}",
                "senderKind": "user",
                "seq": 2,
                "topic": "${grp}",
                "ts": "<time>"
              }
            ],
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 16,
      "do": "send",
      "conn": "b",
      "note": "no topic: no reply at all",
      "sent": {
        "action": "leave"
      }
    },
    {
      "index": 17,
      "do": "send",
      "conn": "b",
      "note": "no membership check",
      "sent": {
        "action": "leave",
        "topic": "grp_missing"
      },
      "frames": {
        "b": [
          {
            "action": "leave",
            "code": 200,
            "id": "s17",
            "topic": "grp_missing"
          }
        ]
      }
    },
    {
      "index": 18,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "sub",
        "topic": "${uid:C}"
      },
      "frames": {
        "a": [
          {
            "action": "pres",
            "online": true,
            "presRev": "<rev>",
            "topic": "${uid:C}",
            "what": "on"
          },
          {
            "action": "sub",
            "code": 200,
            "id": "s18",
            "topic": "${uid:C}"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:C}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 19,
      "do": "send",
      "conn": "a",
      "note": "by the peer's uid",
      "sent": {
        "action": "leave",
        "topic": "${uid:C}"
      },
      "frames": {
        "a": [
          {
            "action": "leave",
            "code": 200,
            "id": "s19",
            "topic": "${uid:C}"
          }
        ]
      }
    },
    {
      "index": 20,
      "do": "close",
      "conn": "c",
      "note": "does A still get C's presence?",
      "frames": {
        "a": [
          {
            "action": "pres",
            "presRev": "<rev>",
            "topic": "${uid:C}",
            "what": "off"
          }
        ]
      }
    },
    {
      "index": 21,
      "do": "connect",
      "conn": "c2"
    },
    {
      "index": 22,
      "do": "login",
      "conn": "c2",
      "frames": {
        "a": [
          {
            "action": "pres",
            "online": true,
            "presRev": "<rev>",
            "topic": "${uid:C}",
            "what": "on"
          }
        ],
        "c2": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:C}"
          }
        ]
      }
    },
    {
      "index": 23,
      "do": "send",
      "conn": "a",
