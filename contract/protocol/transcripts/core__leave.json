      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "before",
        "contentType": "text/plain",
        "clientMsgId": "a-1"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s11",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "data",
            "clientMsgId": "a-1",
            "content": "before",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "name": "subs",
            "senderKind": "user",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 12,
      "do": "send",
      "conn": "b",
      "sent": {
        "action": "leave",
        "topic": "${grp}"
      },
      "frames": {
        "b": [
          {
            "action": "leave",
            "code": 200,
            "id": "s12",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 13,
      "do": "send",
      "conn": "a",
      "note": "B left: no data frame",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "after",
        "contentType": "text/plain",
        "clientMsgId": "a-2"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s13",
            "seq": 2,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 14,
      "do": "send",
      "conn": "b",
      "note": "again, not subscribed",
      "sent": {
        "action": "leave",
        "topic": "${grp}"
      },
      "frames": {
        "b": [
          {
            "action": "leave",
            "code": 200,
