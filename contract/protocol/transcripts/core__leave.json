{
  "scenario": "core/leave",
  "source": "oracle 33e23250",
  "steps": [
    {
      "index": 1,
      "do": "connect",
      "conn": "x"
    },
    {
      "index": 2,
      "do": "send",
      "conn": "x",
      "note": "not logged in: no reply at all",
      "sent": {
        "action": "leave",
        "topic": "grp_missing"
      }
    },
    {
      "index": 3,
      "do": "connect",
      "conn": "b"
    },
    {
      "index": 4,
      "do": "login",
      "conn": "b",
      "frames": {
        "b": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:B}"
          }
        ]
      }
    },
    {
      "index": 5,
      "do": "connect",
      "conn": "c"
    },
    {
      "index": 6,
      "do": "login",
