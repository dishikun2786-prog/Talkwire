    },
    {
      "index": 9,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "create_grp",
        "name": "subs",
        "members": [
          "${uid:B}"
        ]
      },
      "frames": {
        "a": [
          {
            "action": "create_grp",
            "code": 201,
            "id": "s9",
            "name": "subs",
            "topic": "${grp}"
          }
        ],
        "b": [
          {
            "action": "grp_sync",
            "from": "${uid:A}",
            "name": "subs",
            "topic": "${grp}"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:B}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 10,
      "do": "send",
      "conn": "b",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "b": [
          {
            "action": "sub",
            "code": 200,
            "id": "s10",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 11,
      "do": "send",
      "conn": "a",
