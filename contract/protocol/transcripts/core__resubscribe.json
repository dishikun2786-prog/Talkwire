{
  "scenario": "core/resubscribe",
  "source": "oracle 33e23250",
  "steps": [
    {
      "index": 1,
      "do": "connect",
      "conn": "b"
    },
    {
      "index": 2,
      "do": "login",
      "conn": "b",
      "frames": {
        "b": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:B}"
          }
        ]
      }
    },
    {
      "index": 3,
      "do": "connect",
      "conn": "a"
    },
    {
      "index": 4,
      "do": "login",
      "conn": "a",
      "frames": {
        "a": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:A}"
          }
        ]
      }
    },
    {
      "index": 5,
      "do": "send",
      "conn": "a",
      "note": "B is online, so the server subscribes it",
      "sent": {
        "action": "create_grp",
        "name": "resub",
        "members": [
          "${uid:B}"
        ]
      },
      "frames": {
        "a": [
          {
            "action": "create_grp",
            "code": 201,
            "id": "s5",
            "name": "resub",
            "topic": "${grp}"
          }
        ],
        "b": [
          {
            "action": "grp_sync",
            "from": "${uid:A}",
            "name": "resub",
            "topic": "${grp}"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:B}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 6,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "g1",
        "contentType": "text/plain",
        "clientMsgId": "g1"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s6",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "data",
            "clientMsgId": "g1",
            "content": "g1",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "name": "resub",
            "senderKind": "user",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 7,
      "do": "close",
      "conn": "b",
      "frames": {
        "a": [
          {
            "action": "pres",
            "presRev": "<rev>",
            "topic": "${uid:B}",
            "what": "off"
          }
        ]
      }
    },
    {
      "index": 8,
      "do": "connect",
      "conn": "b2"
    },
    {
      "index": 9,
      "do": "login",
      "conn": "b2",
      "frames": {
        "a": [
          {
            "action": "pres",
            "online": true,
            "presRev": "<rev>",
            "topic": "${uid:B}",
            "what": "on"
          }
        ],
        "b2": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:B}"
          }
        ]
      }
    },
    {
      "index": 10,
      "do": "send",
      "conn": "a",
      "note": "B is online but not subscribed: no data frame",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "g2",
        "contentType": "text/plain",
        "clientMsgId": "g2"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s10",
            "seq": 2,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 11,
      "do": "send",
      "conn": "a",
      "note": "1:1: publishing subscribes the online peer",
      "sent": {
        "action": "pub",
        "topic": "${uid:B}",
        "content": "p1",
        "contentType": "text/plain",
        "clientMsgId": "p1"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s11",
            "seq": 1,
            "topic": "${uid:B}",
            "ts": "<time>"
          }
        ],
        "b2": [
          {
            "action": "data",
            "clientMsgId": "p1",
            "content": "p1",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "senderKind": "user",
            "seq": 1,
            "topic": "${uid:A}",
            "ts": "<time>"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:B}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 12,
      "do": "send",
      "conn": "b2",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "b2": [
          {
            "action": "sub",
            "code": 200,
            "id": "s12",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 13,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "g3",
        "contentType": "text/plain",
        "clientMsgId": "g3"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s13",
            "seq": 3,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ],
        "b2": [
          {
            "action": "data",
            "clientMsgId": "g3",
            "content": "g3",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "name": "resub",
            "senderKind": "user",
            "seq": 3,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 14,
      "do": "send",
      "conn": "b2",
      "note": "recovers g2 (and g3)",
      "sent": {
        "action": "get",
        "topic": "${grp}",
        "afterSeq": 1,
        "limit": 10
      },
      "frames": {
        "b2": [
          {
            "action": "get",
            "code": 200,
            "id": "s14",
            "messages": [
              {
                "content": "g2",
                "contentType": "text/plain",
                "from": "${uid:A}",
                "senderKind": "user",
                "seq": 2,
                "topic": "${grp}",
                "ts": "<time>"
              },
              {
                "content": "g3",
                "contentType": "text/plain",
                "from": "${uid:A}",
                "senderKind": "user",
                "seq": 3,
                "topic": "${grp}",
                "ts": "<time>"
              }
            ],
            "topic": "${grp}"
          }
        ]
      }
    }
  ]
}
