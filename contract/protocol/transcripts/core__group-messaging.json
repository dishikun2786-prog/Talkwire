{
  "scenario": "core/group-messaging",
  "source": "oracle 33e23250",
  "steps": [
    {
      "index": 1,
      "do": "connect",
      "conn": "b"
    },
    {
      "index": 2,
      "do": "login",
      "conn": "b",
      "note": "B must have logged in once before it can be added",
      "frames": {
        "b": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:B}"
          }
        ]
      }
    },
    {
      "index": 3,
      "do": "connect",
      "conn": "a"
    },
    {
      "index": 4,
      "do": "login",
      "conn": "a",
      "frames": {
        "a": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:A}"
          }
        ]
      }
    },
    {
      "index": 5,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "create_grp",
        "name": "team",
        "members": [
          "${uid:B}"
        ]
      },
      "frames": {
        "a": [
          {
            "action": "create_grp",
            "code": 201,
            "id": "s5",
            "name": "team",
            "topic": "${grp}"
          }
        ],
        "b": [
          {
            "action": "grp_sync",
            "from": "${uid:A}",
            "name": "team",
            "topic": "${grp}"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:B}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 6,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "a": [
          {
            "action": "sub",
            "code": 200,
            "id": "s6",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 7,
      "do": "send",
      "conn": "b",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "b": [
          {
            "action": "sub",
            "code": 200,
            "id": "s7",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 8,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "hello",
        "contentType": "text/plain",
        "clientMsgId": "a-1"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s8",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "data",
            "clientMsgId": "a-1",
            "content": "hello",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "name": "team",
            "senderKind": "user",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 9,
      "do": "send",
      "conn": "a",
      "note": "same clientMsgId: original seq, no second broadcast (R1)",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "hello",
        "contentType": "text/plain",
        "clientMsgId": "a-1"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s9",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 10,
      "do": "send",
      "conn": "b",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "hi back",
        "contentType": "text/plain",
        "clientMsgId": "b-1"
      },
      "frames": {
        "a": [
          {
            "action": "data",
            "clientMsgId": "b-1",
            "content": "hi back",
            "contentType": "text/plain",
            "from": "${uid:B}",
            "name": "team",
            "senderKind": "user",
            "seq": 2,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "pub",
            "code": 200,
            "id": "s10",
            "seq": 2,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 11,
      "do": "send",
      "conn": "b",
      "sent": {
        "action": "note",
        "topic": "${grp}",
        "what": "read",
        "seq": 2
      },
      "frames": {
        "a": [
          {
            "action": "info",
            "from": "${uid:B}",
            "seq": 2,
            "topic": "${grp}",
            "what": "read"
          }
        ]
      }
    },
    {
      "index": 12,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "note",
        "topic": "${grp}",
        "what": "kp"
      },
      "frames": {
        "b": [
          {
            "action": "info",
            "from": "${uid:A}",
            "topic": "${grp}",
            "what": "kp"
          }
        ]
      }
    },
    {
      "index": 13,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "get",
        "topic": "${grp}",
        "limit": 20
      },
      "frames": {
        "a": [
          {
            "action": "get",
            "code": 200,
            "id": "s13",
            "messages": [
              {
                "content": "hello",
                "contentType": "text/plain",
                "from": "${uid:A}",
                "senderKind": "user",
                "seq": 1,
                "topic": "${grp}",
                "ts": "<time>"
              },
              {
                "content": "hi back",
                "contentType": "text/plain",
                "from": "${uid:B}",
                "senderKind": "user",
                "seq": 2,
                "topic": "${grp}",
                "ts": "<time>"
              }
            ],
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 14,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "get_groups"
      },
      "frames": {
        "a": [
          {
            "action": "get_groups",
            "code": 200,
            "groups": [
              {
                "members": 2,
                "name": "team",
                "owner": "${uid:A}",
                "topic": "${grp}"
              }
            ],
            "id": "s14"
          }
        ]
      }
    },
    {
      "index": 15,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "get_members",
        "topic": "${grp}"
      },
      "frames": {
        "a": [
          {
            "action": "get_members",
            "code": 200,
            "id": "s15",
            "members": [
              {
                "joinedAt": "<time>",
                "role": "member",
                "uid": "${uid:B}"
              },
              {
                "joinedAt": "<time>",
                "role": "owner",
                "uid": "${uid:A}"
              }
            ],
            "topic": "${grp}"
          }
        ]
      }
    }
  ]
}
