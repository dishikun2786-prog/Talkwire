            "type": "forward_bundle_result"
          }
        ]
      }
    },
    {
      "index": 12,
      "do": "send",
      "conn": "a",
      "note": "missing source message",
      "sent": {
        "action": "forward_bundle",
        "reqId": "r3",
        "sourceTopic": "${src}",
        "sourceMsgIds": [
          99
        ],
        "targetTopic": "${dst}"
      },
      "frames": {
        "a": [
          {
            "ok": false,
            "reason": "source_not_found",
            "reqId": "r3",
            "type": "forward_bundle_result"
          }
        ]
      }
    },
    {
      "index": 13,
      "do": "send",
      "conn": "a",
      "note": "creates the p2p topic",
      "sent": {
        "action": "pub",
        "topic": "${uid:B}",
        "content": "hi",
        "contentType": "text/plain",
        "clientMsgId": "a-p2p"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s13",
            "seq": 1,
            "topic": "${uid:B}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "data",
            "clientMsgId": "a-p2p",
            "content": "hi",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "senderKind": "user",
            "seq": 1,
            "topic": "${uid:A}",
            "ts": "<time>"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:B}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 14,
      "do": "send",
      "conn": "a",
      "note": "targets must be canonical topic names: a peer uid is topic_not_found, unlike pub",
      "sent": {
        "action": "forward_broadcast",
        "reqId": "r4",
        "sourceTopic": "${src}",
        "sourceMsgId": 1,
        "targetTopics": [
          "${dst}",
          "${uid:B}",
          "${p2p:A,B}"
        ]
      },
      "frames": {
        "a": [
          {
            "reqId": "r4",
            "results": [
              {
                "ok": true,
                "seq": 3,
                "topic": "${dst}"
              },
              {
                "ok": false,
                "reason": "topic_not_found",
                "topic": "${uid:B}"
              },
              {
                "ok": true,
                "seq": 2,
                "topic": "${p2p:A,B}"
              }
            ],
            "type": "forward_broadcast_result"
          }
        ],
        "b": [
          {
            "action": "data",
            "content": "first",
            "contentType": "text/plain",
            "forwardFromMsgId": 1,
            "forwardFromTopic": "${src}",
            "from": "${uid:A}",
            "senderKind": "user",
            "seq": 2,
            "topic": "${uid:A}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 15,
      "do": "send",
      "conn": "a",
      "note": "same reqId again: the cached result is returned, nothing is forwarded twice",
      "sent": {
        "action": "forward_broadcast",
        "reqId": "r4",
        "sourceTopic": "${src}",
        "sourceMsgId": 1,
        "targetTopics": [
          "${dst}"
