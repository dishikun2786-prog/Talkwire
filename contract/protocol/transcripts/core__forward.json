      ]
    },
    {
      "index": 6,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "create_grp",
        "name": "target",
        "members": []
      },
      "frames": {
        "a": [
          {
            "action": "create_grp",
            "code": 201,
            "id": "s6",
            "name": "target",
            "topic": "${dst}"
          }
        ]
      }
    },
    {
      "index": 7,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "pub",
        "topic": "${src}",
        "content": "first",
        "contentType": "text/plain",
        "clientMsgId": "a-1"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s7",
            "seq": 1,
            "topic": "${src}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "data",
            "clientMsgId": "a-1",
            "content": "first",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "name": "source",
            "senderKind": "user",
            "seq": 1,
            "topic": "${src}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 8,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "pub",
        "topic": "${src}",
        "content": "second",
        "contentType": "text/plain",
        "clientMsgId": "a-2"
      },
      "frames": {
        "a": [
          {
            "action": "pub",
            "code": 200,
            "id": "s8",
            "seq": 2,
            "topic": "${src}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "data",
            "clientMsgId": "a-2",
            "content": "second",
            "contentType": "text/plain",
            "from": "${uid:A}",
            "name": "source",
            "senderKind": "user",
            "seq": 2,
            "topic": "${src}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 9,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "forward_bundle",
        "reqId": "r1",
        "sourceTopic": "${src}",
        "sourceMsgIds": [
          1,
          2
        ],
        "targetTopic": "${dst}"
      },
      "frames": {
        "a": [
          {
            "insertedSeqs": [
              1,
              2
            ],
            "ok": true,
            "reqId": "r1",
            "type": "forward_bundle_result"
          }
        ]
      }
    },
    {
      "index": 10,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "get",
        "topic": "${dst}",
        "limit": 10
      },
      "frames": {
        "a": [
          {
            "action": "get",
            "code": 200,
            "id": "s10",
            "messages": [
              {
                "content": "first",
                "contentType": "text/plain",
                "forwardFromMsgId": 1,
                "forwardFromTopic": "${src}",
                "from": "${uid:A}",
                "senderKind": "user",
                "seq": 1,
                "topic": "${dst}",
                "ts": "<time>"
              },
              {
                "content": "second",
                "contentType": "text/plain",
                "forwardFromMsgId": 2,
                "forwardFromTopic": "${src}",
                "from": "${uid:A}",
