{
  "scenario": "core/supersede",
  "source": "oracle 33e23250",
  "steps": [
    {
      "index": 1,
      "do": "connect",
      "conn": "b"
    },
    {
      "index": 2,
      "do": "login",
      "conn": "b",
      "frames": {
        "b": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:B}"
          }
        ]
      }
    },
    {
      "index": 3,
      "do": "connect",
      "conn": "a1"
    },
    {
      "index": 4,
      "do": "login",
      "conn": "a1",
      "frames": {
        "a1": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:A}"
          }
        ]
      }
    },
    {
      "index": 5,
      "do": "send",
      "conn": "a1",
      "sent": {
        "action": "create_grp",
        "name": "watch",
        "members": [
          "${uid:B}"
        ]
      },
      "frames": {
        "a1": [
          {
            "action": "create_grp",
            "code": 201,
            "id": "s5",
            "name": "watch",
            "topic": "${grp}"
          }
        ],
        "b": [
          {
            "action": "grp_sync",
            "from": "${uid:A}",
            "name": "watch",
            "topic": "${grp}"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:B}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 6,
      "do": "send",
      "conn": "b",
      "note": "B watches A's presence",
      "sent": {
        "action": "sub",
        "topic": "${uid:A}"
      },
      "frames": {
        "b": [
          {
            "action": "pres",
            "online": true,
            "presRev": "<rev>",
            "topic": "${uid:A}",
            "what": "on"
          },
          {
            "action": "sub",
            "code": 200,
            "id": "s6",
            "topic": "${uid:A}"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:B}",
            "b": "${user:A}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 7,
      "do": "send",
      "conn": "b",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "b": [
          {
            "action": "sub",
            "code": 200,
            "id": "s7",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 8,
      "do": "connect",
      "conn": "a2"
    },
    {
      "index": 9,
      "do": "login",
      "conn": "a2",
      "note": "supersedes a1; B must not be told A went offline",
      "frames": {
        "a2": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:A}"
          }
        ],
        "b": [
          {
            "action": "pres",
            "online": true,
            "presRev": "<rev>",
            "topic": "${uid:A}",
            "what": "on"
          }
        ]
      },
      "closed": [
        "a1"
      ]
    },
    {
      "index": 10,
      "do": "send",
      "conn": "a2",
      "note": "a1's cleanup must not remove this subscription",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "a2": [
          {
            "action": "sub",
            "code": 200,
            "id": "s10",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 11,
      "do": "send",
      "conn": "b",
      "note": "reaches a2",
      "sent": {
        "action": "pub",
        "topic": "${grp}",
        "content": "to the group",
        "contentType": "text/plain",
        "clientMsgId": "b-1"
      },
      "frames": {
        "a2": [
          {
            "action": "data",
            "clientMsgId": "b-1",
            "content": "to the group",
            "contentType": "text/plain",
            "from": "${uid:B}",
            "name": "watch",
            "senderKind": "user",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "pub",
            "code": 200,
            "id": "s11",
            "seq": 1,
            "topic": "${grp}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 12,
      "do": "send",
      "conn": "b",
      "note": "reaches a2",
      "sent": {
        "action": "pub",
        "topic": "${uid:A}",
        "content": "direct",
        "contentType": "text/plain",
        "clientMsgId": "b-2"
      },
      "frames": {
        "a2": [
          {
            "action": "data",
            "clientMsgId": "b-2",
            "content": "direct",
            "contentType": "text/plain",
            "from": "${uid:B}",
            "senderKind": "user",
            "seq": 1,
            "topic": "${uid:B}",
            "ts": "<time>"
          }
        ],
        "b": [
          {
            "action": "pub",
            "code": 200,
            "id": "s12",
            "seq": 1,
            "topic": "${uid:A}",
            "ts": "<time>"
          }
        ]
      }
    },
    {
      "index": 13,
      "do": "send",
      "conn": "b",
      "note": "A is still online",
      "sent": {
        "action": "pres",
        "topics": [
          "${uid:A}"
        ]
      },
      "frames": {
        "b": [
          {
            "action": "pres",
            "code": 200,
            "states": [
              {
                "online": true,
                "presRev": "<rev>",
                "uid": "${uid:A}"
              }
            ],
            "what": "snapshot"
          }
        ]
      }
    }
  ]
}
