{
  "scenario": "core/host-red-packet",
  "source": "oracle 33e23250",
  "steps": [
    {
      "index": 1,
      "do": "connect",
      "conn": "b"
    },
    {
      "index": 2,
      "do": "login",
      "conn": "b",
      "frames": {
        "b": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:B}"
          }
        ]
      }
    },
    {
      "index": 3,
      "do": "connect",
      "conn": "a"
    },
    {
      "index": 4,
      "do": "login",
      "conn": "a",
      "frames": {
        "a": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:A}"
          }
        ]
      }
    },
    {
      "index": 5,
      "do": "connect",
      "conn": "c"
    },
    {
      "index": 6,
      "do": "login",
      "conn": "c",
