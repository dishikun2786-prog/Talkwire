      "frames": {
        "c": [
          {
            "action": "login",
            "code": 200,
            "uid": "${uid:C}"
          }
        ]
      }
    },
    {
      "index": 7,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "create_grp",
        "name": "lucky",
        "members": [
          "${uid:B}"
        ]
      },
      "frames": {
        "a": [
          {
            "action": "create_grp",
            "code": 201,
            "id": "s7",
            "name": "lucky",
            "topic": "${grp}"
          }
        ],
        "b": [
          {
            "action": "grp_sync",
            "from": "${uid:A}",
            "name": "lucky",
            "topic": "${grp}"
          }
        ]
      },
      "hostCalls": [
        {
          "method": "GET",
          "path": "/api/v1/internal/im/friendship",
          "query": {
            "a": "${user:A}",
            "b": "${user:B}"
          },
          "status": 200
        }
      ]
    },
    {
      "index": 8,
      "do": "send",
      "conn": "a",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "a": [
          {
            "action": "sub",
            "code": 200,
            "id": "s8",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 9,
      "do": "send",
      "conn": "b",
      "sent": {
        "action": "sub",
        "topic": "${grp}"
      },
      "frames": {
        "b": [
          {
            "action": "sub",
            "code": 200,
            "id": "s9",
            "topic": "${grp}"
          }
        ]
      }
    },
    {
      "index": 10,
      "do": "host",
      "note": "every subscribed connection, the sender included",
      "frames": {
        "a": [
          {
            "action": "red_packet_update",
            "extra": {
              "claimed": 1,
              "lastClaimer": "${uid:B}",
              "packetId": "rp-1",
              "total": 3
            },
            "topic": "${grp}"
          }
        ],
        "b": [
          {
            "action": "red_packet_update",
            "extra": {
              "claimed": 1,
              "lastClaimer": "${uid:B}",
              "packetId": "rp-1",
              "total": 3
            },
            "topic": "${grp}"
          }
        ]
      },
      "hostResponse": {
        "body": {
          "ok": true
        },
        "status": 200
      }
    },
    {
      "index": 11,
      "do": "host",
      "note": "no topic: 400",
      "hostResponse": {
        "body": {
          "error": "topic and payload required"
        },
        "status": 400
      }
    },
    {
      "index": 12,
      "do": "host",
      "note": "unknown topic: accepted, nobody to tell",
      "hostResponse": {
        "body": {
          "ok": true
        },
        "status": 200
      }
