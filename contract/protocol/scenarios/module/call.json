{
  "name": "module/call",
  "description": "Voice/video call signalling: invite rejections (offline, not friends per the host, self, busy), accept with per-side RTC tokens, upgrade to video (declined, then accepted), hangup; then cancel and reject on fresh calls. Media never crosses this protocol.",
  "redlines": ["R16"],
  "users": ["A", "B", "C", "D"],
  "host": {"friends": [["A", "B"]], "profiles": {"A": {"displayName": "Alice", "avatarUrl": "https://example.test/a.png"}}},
  "steps": [
    {"do": "connect", "conn": "b"},
    {"do": "login", "conn": "b", "user": "B"},
    {"do": "connect", "conn": "c"},
    {"do": "login", "conn": "c", "user": "C"},
    {"do": "connect", "conn": "a"},
    {"do": "login", "conn": "a", "user": "A"},
    {"do": "send", "conn": "a", "msg": {"action": "call_invite", "topic": "${uid:D}", "callType": "voice"}, "note": "D is not online"},
    {"do": "send", "conn": "a", "msg": {"action": "call_invite", "topic": "${uid:C}", "callType": "voice"}, "note": "the host says A and C are not friends"},
    {"do": "send", "conn": "a", "msg": {"action": "call_invite", "topic": "${uid:A}", "callType": "voice"}},
    {"do": "send", "conn": "a", "msg": {"action": "call_invite", "topic": "${uid:B}", "callType": "fax"}},
    {"do": "send", "conn": "a", "msg": {"action": "call_invite", "topic": "${uid:B}", "callType": "voice", "clientCallId": "cc-1"}, "capture": {"cs1": "callSessionId"}, "note": "B rings before A gets the ack"},
    {"do": "send", "conn": "c", "msg": {"action": "call_invite", "topic": "${uid:B}", "callType": "voice"}, "note": "B is already in a call"},
    {"do": "send", "conn": "b", "msg": {"action": "call_accept", "callSessionId": "${cs1}"}},
    {"do": "send", "conn": "b", "msg": {"action": "call_accept", "callSessionId": "${cs1}"}, "note": "already answered"},
    {"do": "send", "conn": "a", "msg": {"action": "call_upgrade", "callSessionId": "${cs1}", "toType": "video"}},
    {"do": "send", "conn": "b", "msg": {"action": "call_upgrade_reject", "callSessionId": "${cs1}"}},
    {"do": "send", "conn": "a", "msg": {"action": "call_upgrade", "callSessionId": "${cs1}", "toType": "video"}},
    {"do": "send", "conn": "b", "msg": {"action": "call_upgrade_accept", "callSessionId": "${cs1}"}},
    {"do": "send", "conn": "a", "msg": {"action": "call_upgrade", "callSessionId": "${cs1}", "toType": "video"}, "note": "already video"},
    {"do": "send", "conn": "a", "msg": {"action": "call_hangup", "callSessionId": "${cs1}"}},
    {"do": "send", "conn": "b", "msg": {"action": "call_hangup", "callSessionId": "${cs1}"}, "note": "already ended"},
    {"do": "send", "conn": "a", "msg": {"action": "call_invite", "topic": "${uid:B}", "callType": "video"}, "capture": {"cs2": "callSessionId"}},
    {"do": "send", "conn": "a", "msg": {"action": "call_cancel", "callSessionId": "${cs2}"}},
    {"do": "send", "conn": "a", "msg": {"action": "call_invite", "topic": "${uid:B}", "callType": "video"}, "capture": {"cs3": "callSessionId"}},
    {"do": "send", "conn": "c", "msg": {"action": "call_reject", "callSessionId": "${cs3}"}, "note": "C is not part of the call"},
    {"do": "send", "conn": "b", "msg": {"action": "call_reject", "callSessionId": "${cs3}"}},
    {"do": "send", "conn": "b", "msg": {"action": "call_accept", "callSessionId": "nonexistent-session"}}
  ]
}
