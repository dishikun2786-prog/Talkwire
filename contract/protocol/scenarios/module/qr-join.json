{
  "name": "module/qr-join",
  "description": "Scan-to-join: minting and refreshing the group QR token, resolving it as a non-member, joining directly, then with approval required (request, duplicate request, list, review, second review). D and E are strangers to A; no friendship is needed to join by QR.",
  "users": ["A", "B", "D", "E"],
  "host": {"friends": [["A", "B"]]},
  "steps": [
    {"do": "connect", "conn": "d"},
    {"do": "login", "conn": "d", "user": "D"},
    {"do": "connect", "conn": "e"},
    {"do": "login", "conn": "e", "user": "E"},
    {"do": "connect", "conn": "b"},
    {"do": "login", "conn": "b", "user": "B"},
    {"do": "connect", "conn": "a"},
    {"do": "login", "conn": "a", "user": "A"},
    {"do": "send", "conn": "a", "msg": {"action": "create_grp", "name": "scan", "members": ["${uid:B}"]}, "capture": {"grp": "topic"}},
    {"do": "send", "conn": "a", "msg": {"action": "set_member_role", "topic": "${grp}", "user": "${uid:B}", "memberRole": "admin"}},
    {"do": "send", "conn": "d", "msg": {"action": "group_qr_token", "topic": "${grp}"}, "note": "non-member"},
    {"do": "send", "conn": "a", "msg": {"action": "group_qr_token", "topic": "${grp}"}, "capture": {"qr1": "qrToken"}},
    {"do": "send", "conn": "b", "msg": {"action": "group_qr_token", "topic": "${grp}"}, "note": "same current token"},
    {"do": "send", "conn": "b", "msg": {"action": "group_qr_token", "topic": "${grp}", "refreshQr": true}, "capture": {"qr2": "qrToken"}, "note": "admin may refresh"},
    {"do": "send", "conn": "d", "msg": {"action": "group_qr_resolve", "qrToken": "${qr1}"}, "note": "old token after refresh"},
    {"do": "send", "conn": "d", "msg": {"action": "group_qr_resolve", "qrToken": "${qr2}"}},
    {"do": "send", "conn": "d", "msg": {"action": "group_qr_resolve", "qrToken": "no-such-token"}},
    {"do": "send", "conn": "d", "msg": {"action": "group_join", "qrToken": "${qr2}"}, "note": "no approval needed: joins at once; nobody else is told"},
    {"do": "send", "conn": "d", "msg": {"action": "group_join", "qrToken": "${qr2}"}, "note": "already a member"},
    {"do": "send", "conn": "d", "msg": {"action": "get_members", "topic": "${grp}"}},
    {"do": "send", "conn": "e", "msg": {"action": "get_group_join_settings", "topic": "${grp}"}, "note": "non-member"},
    {"do": "send", "conn": "b", "msg": {"action": "update_group_join_settings", "topic": "${grp}", "requireApproval": true}, "note": "owner only"},
    {"do": "send", "conn": "a", "msg": {"action": "update_group_join_settings", "topic": "${grp}", "requireApproval": true}},
    {"do": "send", "conn": "d", "msg": {"action": "get_group_join_settings", "topic": "${grp}"}},
    {"do": "send", "conn": "e", "msg": {"action": "group_join", "qrToken": "${qr2}", "joinMessage": "please let me in"}, "note": "managers are told"},
    {"do": "send", "conn": "e", "msg": {"action": "group_join", "qrToken": "${qr2}", "joinMessage": "again"}, "note": "duplicate request"},
    {"do": "send", "conn": "d", "msg": {"action": "group_join_requests_list", "topic": "${grp}"}, "note": "plain member"},
    {"do": "send", "conn": "b", "msg": {"action": "group_join_requests_list", "topic": "${grp}"}},
    {"do": "send", "conn": "b", "msg": {"action": "group_join_review", "topic": "${grp}", "joinRequestId": 1, "approve": true}},
    {"do": "send", "conn": "a", "msg": {"action": "group_join_review", "topic": "${grp}", "joinRequestId": 1, "approve": false}, "note": "already handled"},
    {"do": "send", "conn": "b", "msg": {"action": "group_join_requests_list", "topic": "${grp}"}, "note": "nothing pending"}
  ]
}
