{
  "name": "module/e2ee-p2p",
  "description": "1:1 end-to-end encryption relay: publishing a key bundle, fetching it (consumes one-time prekeys; strangers get found:false), relaying ciphertext live and through the offline queue, and the clear/terminate notices. The server never sees plaintext; the payloads here are dummy base64.",
  "redlines": ["R17"],
  "users": ["A", "B", "C"],
  "host": {"friends": [["A", "B"]]},
  "steps": [
    {"do": "connect", "conn": "c"},
    {"do": "login", "conn": "c", "user": "C"},
    {"do": "connect", "conn": "b"},
    {"do": "login", "conn": "b", "user": "B"},
    {"do": "connect", "conn": "a"},
    {"do": "login", "conn": "a", "user": "A"},
    {"do": "send", "conn": "a", "msg": {"action": "e2e_publish_bundle", "reqId": "p1", "e2eBundle": {"registrationId": 11, "identityKey": "SUtB", "signedPreKeyId": 1, "signedPreKey": "U1BLQQ", "signedPreKeySignature": "U0lHQQ", "kyberPreKeyId": 1, "kyberPreKey": "S1BLQQ", "kyberPreKeySignature": "S1NJR0E", "oneTimePreKeys": [{"keyId": 101, "preKey": "T1RQMTAx"}, {"keyId": 102, "preKey": "T1RQMTAy"}]}}, "awaitMatch": {"type": "e2e_publish_bundle_result", "reqId": "p1"}},
    {"do": "send", "conn": "a", "msg": {"action": "e2e_publish_bundle", "reqId": "p2", "e2eBundle": {"registrationId": 11, "signedPreKeyId": 1, "signedPreKey": "U1BLQQ", "signedPreKeySignature": "U0lHQQ", "kyberPreKeyId": 1, "kyberPreKey": "S1BLQQ", "kyberPreKeySignature": "S1NJR0E"}}, "awaitMatch": {"type": "e2e_publish_bundle_result", "reqId": "p2"}, "note": "identityKey missing"},
    {"do": "send", "conn": "a", "msg": {"action": "e2e_otpk_count", "reqId": "n1"}, "awaitMatch": {"type": "e2e_otpk_count_result", "reqId": "n1"}},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_fetch_bundle", "reqId": "f1", "user": "${uid:A}"}, "awaitMatch": {"type": "e2e_bundle", "reqId": "f1"}, "note": "consumes one-time prekey 101"},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_fetch_bundle", "reqId": "f2", "user": "${uid:A}"}, "awaitMatch": {"type": "e2e_bundle", "reqId": "f2"}, "note": "consumes 102"},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_fetch_bundle", "reqId": "f3", "user": "${uid:A}"}, "awaitMatch": {"type": "e2e_bundle", "reqId": "f3"}, "note": "pool empty: no one-time prekey"},
    {"do": "send", "conn": "a", "msg": {"action": "e2e_otpk_count", "reqId": "n2"}, "awaitMatch": {"type": "e2e_otpk_count_result", "reqId": "n2"}},
    {"do": "send", "conn": "c", "msg": {"action": "e2e_fetch_bundle", "reqId": "f4", "user": "${uid:A}"}, "awaitMatch": {"type": "e2e_bundle", "reqId": "f4"}, "note": "C is a stranger to A"},
    {"do": "send", "conn": "a", "msg": {"action": "e2e_fetch_bundle", "reqId": "f5", "user": "${uid:B}"}, "awaitMatch": {"type": "e2e_bundle", "reqId": "f5"}, "note": "B never published"},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_send", "topic": "${p2p:A,B}", "user": "${uid:A}", "e2eKind": "msg", "e2eMsgType": 3, "content": "Q0lQSEVSMQ"}, "note": "A is online: delivered live"},
    {"do": "send", "conn": "c", "msg": {"action": "e2e_send", "topic": "${p2p:A,C}", "user": "${uid:A}", "e2eKind": "msg", "e2eMsgType": 3, "content": "Q0lQSEVSWA"}, "note": "stranger"},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_send", "topic": "${p2p:A,B}", "user": "${uid:A}", "e2eKind": "msg", "e2eMsgType": 2}, "note": "msg kind without content"},
    {"do": "close", "conn": "a"},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_send", "topic": "${p2p:A,B}", "user": "${uid:A}", "e2eKind": "msg", "e2eMsgType": 2, "content": "Q0lQSEVSMg"}, "note": "A is offline: queued"},
    {"do": "connect", "conn": "a2"},
    {"do": "login", "conn": "a2", "user": "A", "note": "the queued envelope is delivered"},
    {"do": "close", "conn": "a2"},
    {"do": "connect", "conn": "a3"},
    {"do": "login", "conn": "a3", "user": "A", "note": "delivered envelopes are deleted: nothing again"},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_clear", "topic": "${p2p:A,B}", "user": "${uid:A}"}},
    {"do": "send", "conn": "b", "msg": {"action": "e2e_terminate", "topic": "${p2p:A,B}", "user": "${uid:A}"}}
  ]
}
