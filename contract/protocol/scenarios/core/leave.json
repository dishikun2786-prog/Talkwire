{
  "name": "core/leave",
  "description": "leave unsubscribes this connection from a topic; it does not touch membership. Without login or without a topic there is no reply at all. A group member who leaves gets no live data but can still read history. For 1:1 chats the subscription is held under the canonical p2p topic, so leaving by the peer's uid changes nothing (presence still arrives) while leaving by the p2p topic stops presence; a new message from the peer subscribes again. C is A's friend; B shares a group with A.",
  "users": ["A", "B", "C"],
  "host": {"friends": [["A", "B"], ["A", "C"]]},
  "steps": [
    {"do": "connect", "conn": "x"},
    {"do": "send", "conn": "x", "msg": {"action": "leave", "topic": "grp_missing"}, "await": "none", "note": "not logged in: no reply at all"},
    {"do": "connect", "conn": "b"},
    {"do": "login", "conn": "b", "user": "B"},
    {"do": "connect", "conn": "c"},
    {"do": "login", "conn": "c", "user": "C"},
    {"do": "connect", "conn": "a"},
    {"do": "login", "conn": "a", "user": "A"},
    {"do": "send", "conn": "a", "msg": {"action": "create_grp", "name": "subs", "members": ["${uid:B}"]}, "capture": {"grp": "topic"}},
    {"do": "send", "conn": "b", "msg": {"action": "sub", "topic": "${grp}"}},
    {"do": "send", "conn": "a", "msg": {"action": "pub", "topic": "${grp}", "content": "before", "contentType": "text/plain", "clientMsgId": "a-1"}, "note": "B is subscribed"},
    {"do": "send", "conn": "b", "msg": {"action": "leave", "topic": "${grp}"}},
    {"do": "send", "conn": "a", "msg": {"action": "pub", "topic": "${grp}", "content": "after", "contentType": "text/plain", "clientMsgId": "a-2"}, "note": "B left: no data frame"},
    {"do": "send", "conn": "b", "msg": {"action": "leave", "topic": "${grp}"}, "note": "again, not subscribed"},
    {"do": "send", "conn": "b", "msg": {"action": "get", "topic": "${grp}", "afterSeq": 1, "limit": 10}, "note": "still a member: history works"},
    {"do": "send", "conn": "b", "msg": {"action": "leave"}, "await": "none", "note": "no topic: no reply at all"},
    {"do": "send", "conn": "b", "msg": {"action": "leave", "topic": "grp_missing"}, "note": "no membership check"},
    {"do": "send", "conn": "a", "msg": {"action": "sub", "topic": "${uid:C}"}},
    {"do": "send", "conn": "a", "msg": {"action": "leave", "topic": "${uid:C}"}, "note": "by the peer's uid"},
    {"do": "close", "conn": "c", "note": "does A still get C's presence?"},
    {"do": "connect", "conn": "c2"},
    {"do": "login", "conn": "c2", "user": "C"},
    {"do": "send", "conn": "a", "msg": {"action": "leave", "topic": "${p2p:A,C}"}, "note": "by the canonical p2p topic"},
    {"do": "close", "conn": "c2", "note": "does A still get C's presence?"},
    {"do": "connect", "conn": "c3"},
    {"do": "login", "conn": "c3", "user": "C"},
    {"do": "send", "conn": "c3", "msg": {"action": "pub", "topic": "${uid:A}", "content": "hi", "contentType": "text/plain", "clientMsgId": "c-1"}, "note": "a message from C reaches A and subscribes A again"},
    {"do": "close", "conn": "c3", "note": "presence again?"}
  ]
}
